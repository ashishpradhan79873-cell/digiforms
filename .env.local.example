# Copy this file to `.env.local` and set your own values.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional, only if your host needs an outbound proxy
# CLOUDINARY_API_PROXY=http://proxy.example.com:8080

# Cashfree sandbox / production
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_MODE=sandbox
CASHFREE_API_VERSION=2025-01-01

# Optional database config for MySQL/Postgres
# DATABASE_URL=mysql://user:password@host:3306/dbname
